{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "numberOfRuns": 3,
      "settings": { "preset": "desktop" },
      "url": [
        "http://localhost/index.html",
        "http://localhost/en/index.html",
        "http://localhost/es/index.html",

        "http://localhost/empresas/index.html",
        "http://localhost/en/empresas/index.html",
        "http://localhost/es/empresas/index.html",

        "http://localhost/noticias/index.html",
        "http://localhost/noticias/arquivo/index.html",

        "http://localhost/noticia/ata-da-assembleia-geral-ordinaria-e-extraordinaria/index.html",
        "http://localhost/en/noticia/minutes-of-the-annual-and-extraordinary-shareholders-meeting/index.html",

        "http://localhost/group/pesquisa-e-desenvolvimento/index.html",
        "http://localhost/faq/projetos-de-pd-em-andamento/index.html",
        "http://localhost/politica-de-privacidade/condicoes-de-uso/index.html",
        "http://localhost/video/video-institucional/alupar-institucional-2017_edit/index.html"
      ]
    },
    "assert": {
      "assertions": {
        "categories:performance":   ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 1.0 }],
        "categories:seo":           ["error", { "minScore": 0.9 }],
        "categories:best-practices":["error", { "minScore": 0.9 }],

        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift":  ["error", { "maxNumericValue": 0.1 }],

        "total-byte-weight":        ["error", { "maxNumericValue": 614400 }],
        "modern-image-formats":     "error",
        "uses-responsive-images":   "error",
        "offscreen-images":         "error",

        "meta-description":         "error",
        "image-alt":                "error",
        "html-has-lang":            "error",
        "color-contrast":           "error",
        "label":                    "error"
      }
    },
    "upload": { "target": "temporary-public-storage" }
  }
}
