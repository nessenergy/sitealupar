{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop"
      },
      "url": [
        "http://localhost/index.html",
        "http://localhost/en/index.html",
        "http://localhost/es/index.html",
        "http://localhost/empresas/index.html",
        "http://localhost/en/empresas/index.html",
        "http://localhost/es/empresas/index.html",

        "http://localhost/videos/index.html",
        "http://localhost/en/videos/index.html",

        "http://localhost/group/sustentabilidade-nova/index.html",
        "http://localhost/en/group/sustainability/index.html",

        "http://localhost/group/pesquisa-e-desenvolvimento/index.html",
        "http://localhost/faq/projetos-de-pd-em-andamento/index.html",
        "http://localhost/politica-de-privacidade/condicoes-de-uso/index.html",
        "http://localhost/a-companhia/index.html",
        "http://localhost/contato/index.html"
      ]
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 2500
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.1
          }
        ],
        "total-byte-weight": [
          "error",
          {
            "maxNumericValue": 3145728
          }
        ],
        "modern-image-formats": "error",
        "uses-responsive-images": "error",
        "offscreen-images": "error",
        "meta-description": "error",
        "image-alt": "error",
        "html-has-lang": "error",
        "color-contrast": "error",
        "label": "error"
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
