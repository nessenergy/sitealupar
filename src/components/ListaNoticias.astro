---
/**
 * Listagem de notícias (N2) e arquivo paginado (N3), nos três idiomas.
 * Com `pagina`, é o arquivo; sem, é a listagem, que aponta para o arquivo.
 */
import type { Page } from 'astro';
import Base from '../layouts/Base.astro';
import type { Item } from '../lib/acervo';
import { textos, prefixo, lang, type Idioma } from '../i18n/textos';

interface Props { idioma: Idioma; lista: Item[]; pagina?: Page<Item> }
const { idioma, lista, pagina } = Astro.props;
const t = textos[idioma];
const formato = new Intl.DateTimeFormat(lang[idioma], { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const titulo = pagina
  ? `${t.arquivo}${pagina.currentPage > 1 ? ` — ${pagina.currentPage}` : ''}`
  : t.noticias;
// O paginate() devolve a URL sem a barra final; o Pages responde 308 até a com barra.
const comBarra = (u: string) => (u.endsWith('/') ? u : `${u}/`);
---
<Base titulo={`${titulo} — Alupar`} descricao={t.descricao} idioma={idioma}>
  <main id="conteudo" class="container pagina">
    <div class="caixa">
    <h1>{titulo}</h1>
    <ul class="lista">
      {lista.map((n) => (
        <li>
          <time datetime={n.data}>{formato.format(new Date(`${n.data}T00:00:00Z`))}</time>
          <a href={n.rota}>{n.titulo}</a>
        </li>
      ))}
    </ul>
    {/* Arquivo de uma página só (hoje, o ES): sem anterior nem próxima, o
        <nav> seria um marco vazio anunciado pelo leitor de tela. */}
    {pagina ? (
      (pagina.url.prev || pagina.url.next) && (
        <nav class="paginas" aria-label={t.arquivo}>
          {pagina.url.prev && <a href={comBarra(pagina.url.prev)} rel="prev">{t.anterior}</a>}
          {pagina.url.next && <a href={comBarra(pagina.url.next)} rel="next">{t.proxima}</a>}
        </nav>
      )
    ) : (
      <p><a href={`${prefixo[idioma]}/noticias/arquivo/`}>{t.arquivo}</a></p>
    )}
    </div>
  </main>
</Base>

<style>
  /* .list-group do tema: uma linha por notícia, data e título lado a lado, sem
     fio entre os itens e com as linhas ímpares em #F8F8F8. O título é link em
     peso normal, sem sublinhado — sublinhado no hover e no foco. A caixa
     branca e o título verde vêm de tokens.css.

     Antes a data ficava por extenso acima do título, o título vinha em negrito
     sublinhado e a lista, sem a caixa, encolhia para uma coluna de ~226 px no
     meio da página em 1280. */
  .lista { list-style: none; margin: 0 0 var(--e5); padding: 0; }
  .lista li { display: flex; flex-wrap: wrap; gap: 20px; padding: 15px 10px; }
  .lista li:nth-child(odd) { background: var(--cinza-fundo); }
  .lista time { flex: none; }
  .lista a { color: var(--preto); text-decoration: none; }
  .lista a:hover, .lista a:focus-visible { text-decoration: underline; }
  .paginas { display: flex; justify-content: space-between; gap: var(--e4); }
</style>
