---
/**
 * Rodapé do tema, com o fundo e a marca pedidos pela Alupar em 23/09/2026:
 * #2F008E no lugar do #231F20, a marca negativa à esquerda e os links à
 * direita, empilhados abaixo de 768 px. Caixa alta e links sem sublinhado
 * separados por "|", como no tema. O texto é de 12 px por causa da D21; o tema
 * tinha 11 px. Sai o "Powered by MZ". Os códigos de conduta passam a vir do R2
 * — hoje moram em api.mziq.com e sumiriam com o contrato (Tarefa 5).
 *
 * A marca é a arte que a Alupar enviou (300×97, branco e verde sobre
 * transparente). Ela aparece a 150 px, e por isso passa pelo pipeline de imagem
 * do Astro em vez de ir direta: servir os 300 px do arquivo para exibir 150
 * reprova `uses-responsive-images` no portão do CI, em toda página. Com
 * `densities`, quem tem tela comum baixa a de 150 e quem tem tela densa baixa a
 * de 300 — o arquivo original continua sendo o teto, nada é ampliado.
 * `alt=""`: ela repete a marca do cabeçalho, que já tem texto alternativo — um
 * alt aqui faria o leitor de tela anunciar "Alupar" duas vezes na mesma página.
 *
 * O círculo de "voltar ao topo" usa --rodape-texto e não o #535252 do tema:
 * 2,2:1 sobre o fundo reprova o 3:1 de componente de interface (WCAG 1.4.11).
 */
import { Image } from 'astro:assets';
import marca from '../assets/logo-alupar-rodape.png';
import { textos, type Idioma } from '../i18n/textos';

interface Props { idioma: Idioma }
const t = textos[Astro.props.idioma];
const r = t.rodape;
const externos = [
  { rotulo: r.conduta, href: r.condutaHref },
  { rotulo: r.terceiros, href: 'https://arquivos.alupar.com.br/documentos/codigo-de-conduta-de-terceiros.pdf' },
  { rotulo: r.denuncias, href: 'https://contatoseguro.com.br/pt/alupar/' },
];
---
<footer class="rodape">
  <div class="container">
    <a class="topo" href="#topo"><span aria-hidden="true">︿</span><span class="sr-only">{r.topo}</span></a>
    <div class="faixa">
      <Image class="marca" src={marca} alt="" width={150} densities={[1, 2]} />
      <div class="textos">
        <ul>
          <li><a href={r.privacidadeHref}>{r.privacidade}</a></li>
          {externos.map((e) => (
            <li><a href={e.href} target="_blank" rel="noopener noreferrer">{e.rotulo}<span class="sr-only"> ({t.novaAba})</span></a></li>
          ))}
        </ul>
        <p class="direitos">© {new Date().getFullYear()} ALUPAR - {r.direitos}</p>
      </div>
    </div>
  </div>
</footer>

<style>
  .rodape { background: var(--rodape-fundo); padding-top: 10px; text-align: center; }
  /* O círculo continua com 23 px; a área de toque é de 44 px (WCAG 2.5.8 pede 24,
     e 44 é o tamanho de um dedo). As margens negativas devolvem os 21 px que a
     área a mais tomaria, para o rodapé não crescer. */
  .topo {
    position: relative; display: inline-grid; place-items: center; width: 44px; height: 44px;
    margin-block: -10px -11px;
    color: var(--rodape-texto); text-decoration: none; line-height: 1;
  }
  .topo::before {
    content: ''; position: absolute; inset: 0; margin: auto; width: 23px; height: 23px;
    box-sizing: border-box; border: 2px solid var(--rodape-texto); border-radius: 50%;
  }
  /* O anel de foco global segue o raio do elemento, e o .topo é quadrado (44 px):
     o anel vai para o círculo de 23 px, que é o que o teclado enxerga. */
  .topo:focus-visible { outline: none; }
  .topo:focus-visible::before { outline: 3px solid var(--azul); outline-offset: 2px; }
  /* Marca à esquerda, textos à direita; abaixo de 768 px os dois empilham e
     voltam ao centro, que é como o rodapé do tema sempre foi. */
  .faixa {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
    gap: var(--e3); margin-top: 8px; padding-bottom: 8px;
  }
  /* 150 px é metade do arquivo: a arte tem 300 px e reduzir é o único caminho
     que não borra. `height: auto` mantém a proporção dos 300×97. */
  .marca { display: block; width: 150px; height: auto; }
  .textos { text-align: right; }
  ul {
    display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 0 3px;
    list-style: none; margin: 0; padding: 0;
    font-size: 12px; text-transform: uppercase; color: var(--rodape-texto);
  }
  /* .list-inline > li do bootstrap: 5 px de cada lado; o espaço entre os li
     inline-block dá os outros 3 px — ~13 px entre o texto e o "|". O "|" vai
     com o item da esquerda, para não abrir a linha de baixo na quebra. */
  li { padding-inline: 5px; }
  li:not(:last-child)::after { content: '|' / ''; margin-left: 13px; }
  /* Linha de 24 px nos links, não os ~16 px do tema: quando a lista quebra,
     com 16 px entre as linhas o espaço livre em volta de cada link mede
     15,8 px e reprova target-size (WCAG 2.5.8 pede 24 px). */
  a { display: inline-block; line-height: 24px; color: var(--rodape-texto); text-decoration: none; }
  /* a:hover e a:focus do style.css: sublinhado, na mesma cor */
  a:hover, a:focus { color: var(--rodape-texto); text-decoration: underline; }
  .direitos {
    margin: 2px 0 0; font-size: 12px; line-height: 17px;
    text-transform: uppercase; color: var(--rodape-texto);
  }
  @media (max-width: 767px) {
    .faixa { flex-direction: column; justify-content: center; gap: var(--e2); }
    .textos { text-align: center; }
    ul { justify-content: center; }
    /* Com 12 px, a segunda linha ("Código de conduta de terceiros | Canal de
       denúncias", 379 px) não cabe nos 360 px da lista a 390 px de largura e o
       rodapé ganharia uma terceira linha. A lista avança 12 px sobre o
       preenchimento do container em cada lado (384 px): mesma quebra de antes. */
    ul { margin-inline: -12px; }
  }
</style>
