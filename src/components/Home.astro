---
/**
 * A home, uma vez, nos três idiomas: vídeo institucional no topo, faixa
 * institucional (D10) e as duas caixas — notícias e sustentabilidade.
 *
 * O topo era o rotativo do site atual até 16/09/2026, quando a Alupar pediu o
 * vídeo no lugar dele. O vídeo é o mesmo que a home trazia numa caixa entre as
 * três de baixo; ela saiu junto, para a peça não aparecer duas vezes.
 *
 * Vídeo sob demanda (H4): a capa é local e o player do YouTube — ~1 MB, o
 * orçamento inteiro da página — só carrega no clique (public/js/site.js).
 * Sem JS, o link leva ao vídeo no YouTube. Sem autoplay: vídeo que começa
 * sozinho é conteúdo em movimento e cairia na WCAG 2.2.2, que exige controle
 * de pausa visível, contra um portão de acessibilidade que pede nota cheia.
 */
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { noticiasDe } from '../lib/acervo';
import { textos, prefixo, lang, CODIGO, type Idioma } from '../i18n/textos';
import capaVideo from '../assets/video-institucional.jpg';

interface Props { idioma: Idioma }
const { idioma } = Astro.props;
const t = textos[idioma];
const pre = prefixo[idioma];
/* O rotativo saiu do topo em 16/09/2026 e com ele saíram `telas()`, as imagens
   de banner e o par `rotativo`/`gira`. As peças continuam versionadas em
   `src/assets/banners/` e a máquina do carrossel continua em `src/lib/banners.ts`
   e em `public/js/site.js`: se a decisão voltar atrás, nada precisa ser
   reescrito, basta o topo voltar a montar as telas. */
const ICONES = ['meio-ambiente', 'agua', 'fauna-e-flora'].map((n) => `/img/tema/icone-${n}.png`);

// Os dois valores nulos são pendências da Alupar. A regra 4 do AGENTS.md: um
// número plausível é pior que um espaço vazio, porque ninguém o corrige depois.
const indicadores = [
  { valor: null,  rotulo: t.indicadores.linhas },
  { valor: '4',   rotulo: t.indicadores.paises },
  { valor: null,  rotulo: t.indicadores.capacidade },
  { valor: 'AAA', rotulo: t.indicadores.rating },
];

const formato = new Intl.DateTimeFormat(lang[idioma], { day: '2-digit', month: '2-digit', year: 'numeric', timeZone: 'UTC' });
const noticias = noticiasDe(CODIGO[idioma]).slice(0, 6);
---
<Base titulo={t.titulo} descricao={t.descricao} idioma={idioma} interna={false}>
  <main id="conteudo">
    <!-- O h1 do site atual é o logotipo com `font: 0/0 a`: nenhum texto chega
         ao leitor de tela. Aqui é texto real, oculto visualmente. -->
    <h1 class="sr-only">Alupar</h1>

    {/* Vídeo no lugar do rotativo, a pedido da Alupar em 16/09/2026. É o mesmo
        institucional que a home já trazia numa caixa mais abaixo — essa caixa
        sai junto, senão a mesma peça apareceria duas vezes na mesma página.

        A carga é a que a decisão P8 já fixou: a capa é local e o player do
        YouTube (~1 MB) só entra no clique. Pôr o iframe no carregamento faria
        dele o LCP da home, que hoje é de 356 ms.

        Sem autoplay, de propósito. Vídeo que começa sozinho é conteúdo em
        movimento e cai na WCAG 2.2.2, que exige controle de pausa visível — e
        o portão de acessibilidade deste projeto exige nota cheia.

        A faixa mantém os 447 px do tema (D2). O vídeo é 16:9 e ocupa a altura
        da faixa, centrado sobre o cinza dela, em vez de ser recortado por
        `object-fit` numa caixa de proporção 2,86:1, que mostraria uma tira do
        quadro. 447 px de altura pedem ~794 px de largura. */}
    <section class="destaques destaque-video" aria-label={t.videoInstitucional}>
      <a class="video-topo" href="https://www.youtube.com/watch?v=oqjwsKfpYZ4"
        data-video="oqjwsKfpYZ4" data-titulo={t.videoInstitucional}>
        <Picture src={capaVideo} alt="" formats={['avif', 'webp']}
          widths={[640, 800, 1280]} sizes="(min-width: 860px) 794px, 100vw"
          loading="eager" fetchpriority="high" />
        <span class="sr-only">{t.assistirVideo}</span>
      </a>
      {/* O atalho para a listagem morava na caixa que saiu. Sem ele, /videos/
          perderia o único link que a home lhe dava. */}
      <a class="mais mais-video" href={`${pre}/videos/`}>
        <span class="circulo" aria-hidden="true">+</span> {t.verMaisVideos}
      </a>
    </section>

    <section class="faixa" aria-label={t.emNumeros}>
      <div class="container">
        <ul>
          {indicadores.map((i) => (
            <li>
              <span class="valor" data-pendente={i.valor === null}>{i.valor ?? '—'}</span>
              <span class="rotulo">{i.rotulo}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <div class="container caixas">
      <section class="caixa" aria-labelledby="h-noticias">
        <h2 id="h-noticias">{t.noticias}</h2>
        <ul class="noticias">
          {noticias.map((n) => (
            <li>
              <time datetime={n.data}>{formato.format(new Date(`${n.data}T00:00:00Z`))}</time>
              <a href={n.rota}>{n.titulo}</a>
            </li>
          ))}
        </ul>
        <a class="mais" href={`${pre}/noticias/`}><span class="circulo" aria-hidden="true">+</span> {t.verMaisNoticias}</a>
      </section>

      {/* A caixa do vídeo institucional saiu daqui em 16/09/2026: a mesma peça
          subiu para o topo, no lugar do rotativo. O atalho para a listagem de
          vídeos, que morava nesta caixa, passa a viver no rodapé do topo. */}
      <section class="caixa" aria-labelledby="h-sustentabilidade">
        <h2 id="h-sustentabilidade">{t.sustentabilidade}</h2>
        <ul class="eixos">
          {t.eixos.map((e, n) => (
            <li>
              <img src={ICONES[n]} alt="" width="29" height="38" />
              <div>
                <h3><a href={t.sustentabilidadeHref}>{e.titulo}</a></h3>
                <p>{e.texto}</p>
              </div>
            </li>
          ))}
        </ul>
        <a class="mais" href={t.sustentabilidadeHref}><span class="circulo" aria-hidden="true">+</span> {t.saibaMais}</a>
      </section>
    </div>
  </main>
</Base>

<style>
  /* A faixa guarda os 447 px que o tema dá ao banner (#home > .banner .item em
     css/fullwidth/skin.css) e o cinza de fundo dele. O que muda dentro é só o
     conteúdo: em vez de arte recortada de ponta a ponta, o vídeo 16:9 ocupa a
     altura da faixa e fica centrado. Altura fixa também protege o CLS, que o
     CI cobra em 0,1: a capa e o iframe que a substitui medem o mesmo. */
  .destaque-video {
    height: 447px; background: var(--cinza-fundo);
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: var(--e2);
  }
  /* 447 px de altura em 16:9 pedem ~794 px de largura. `min()` cuida das telas
     estreitas sem media query: abaixo disso o vídeo usa a largura disponível. */
  .destaque-video :global(.video-topo) {
    position: relative; display: block;
    width: min(100% - 2 * var(--e4), 794px); aspect-ratio: 16 / 9;
  }
  .destaque-video :global(.video-topo) :global(img) {
    display: block; width: 100%; height: 100%; object-fit: cover;
  }
  /* Mesmo indicador de play da caixa que saiu: sem ele a capa parece foto. */
  .destaque-video :global(.video-topo)::after {
    content: '▶' / ''; position: absolute; inset: 0; display: grid; place-items: center;
    font-size: 4rem; color: var(--branco);
  }
  .destaque-video :global(iframe.video) {
    width: min(100% - 2 * var(--e4), 794px); aspect-ratio: 16 / 9; height: auto; border: 0;
  }
  /* Abaixo de ~860 px o vídeo encolhe e os 447 px sobrariam como cinza vazio. */
  @media (max-width: 859px) {
    .destaque-video { height: auto; padding-block: var(--e4); }
  }

  .faixa { border-block: 1px solid var(--cinza-borda); background: var(--cinza-fundo); }
  .faixa ul {
    list-style: none; margin: 0; padding: var(--e5) 0;
    display: grid; gap: var(--e4);
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  }
  .faixa li { display: flex; flex-direction: column; gap: var(--e1); }
  .valor { font-size: 2rem; font-weight: 700; line-height: 1.1; color: var(--verde-texto); }
  .valor[data-pendente='true'] { color: var(--cinza); }
  .rotulo { font-size: .875rem; color: var(--preto); }

  /* .box-home do tema: branca, sombra 3px 3px 5px, título azul 20px */
  .caixas { display: grid; gap: 30px; padding-block: var(--e5) 50px; }
  /* Eram três colunas; a do vídeo subiu para o topo em 16/09/2026 e sobraram
     duas. Duas colunas, e não três com um buraco. */
  @media (min-width: 768px) { .caixas { grid-template-columns: repeat(2, 1fr); } }
  .caixa {
    display: flex; flex-direction: column; background: var(--branco);
    padding: 1px 20px 8px; box-shadow: 3px 3px 5px 0 rgba(0, 0, 0, .2);
  }
  /* O título das caixas é verde e de peso normal no site atual: o tema pede
     azul em .box-home h3, mas um seletor solto mais abaixo no mesmo style.css
     (`.page-id-2810 h1, h3 { color: #079541 !important }`) alcança todos os h3
     da página, e `h1..h6 { font-weight: normal }` tira o negrito.
     O verde de texto é --verde-texto (4,51:1); o de marca dá 3,90:1. */
  .caixa h2 {
    color: var(--verde-texto); font-size: 20px; font-weight: 400;
    text-transform: uppercase; margin: 20px 0;
  }

  /* No tema a lista da caixa é um <ul> comum, sem folha que a redefina: vem o
     marcador de disco do navegador. A data está num <strong> com o negrito
     zerado pelo style.css, e o título é link azul sem sublinhado — sublinhado
     só no hover e no foco, como em todo link do tema. Numa lista de links
     (não de texto corrido), a ausência de sublinhado não fere a WCAG 1.4.1. */
  .noticias { list-style: disc; margin: 0; padding-left: 20px; flex: 1; }
  .noticias li { margin-bottom: 10px; }
  .noticias time { display: block; font-weight: 400; }
  .noticias a { color: var(--azul); text-decoration: none; }
  .noticias a:hover, .noticias a:focus-visible { text-decoration: underline; }

  /* o iframe é criado pelo site.js no clique e não recebe o atributo de
     escopo do Astro — por isso :global dentro de .caixa. */
  /* .embed-responsive-4by3 do tema: a caixa do vídeo é 4:3 e só isso — não
     estica. Com `flex: 1` ela crescia até o pé da caixa e virava um retrato de
     ~310 × 400 px em 1280, contra os ~320 × 240 px do site atual. É a margem
     automática do link "veja mais" que passa a empurrá-lo para a base. */
  .caixa .mais { margin-top: auto; }
  .caixa :global(.video) { position: relative; display: block; aspect-ratio: 4 / 3; }
  .caixa :global(.video) :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .caixa :global(.video)::after {
    content: '▶' / ''; position: absolute; inset: 0; display: grid; place-items: center;
    font-size: 3rem; color: var(--branco);
  }
  .caixa :global(iframe.video) { width: 100%; height: auto; border: 0; }

  .eixos { list-style: none; margin: 0; padding: 0; flex: 1; }
  .eixos li { display: flex; gap: 20px; padding-block: var(--e3); border-bottom: 1px solid #EFEEEF; }
  .eixos li:last-child { border-bottom: none; }
  /* .list-sustentabilidade .media do tema: o título de cada eixo é um
     h5.media-heading — 14 px, peso normal (o tema zera o negrito de h1 a h6),
     5 px embaixo — e o link é cinza-escuro sem sublinhado, com sublinhado no
     hover e no foco. Estava em negrito e sublinhado. */
  .eixos h3 { font-size: 14px; font-weight: 400; margin: 0 0 5px; }
  .eixos h3 a { color: var(--preto); text-decoration: none; }
  .eixos h3 a:hover, .eixos h3 a:focus-visible { text-decoration: underline; }
  .eixos p { margin: 0; line-height: 24px; }

  /* a.btn-link-mais do tema: caixa alta 12px, sublinhado verde de 4px */
  .mais {
    align-self: flex-end; margin: 9px -20px 0 0; padding: 0 5px 12px;
    position: relative; color: var(--preto); font-size: 12px; text-transform: uppercase; text-decoration: none;
  }
  .mais::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; border-bottom: 4px solid var(--verde); }
  .circulo {
    display: inline-block; width: 15px; height: 15px; margin-right: 3px;
    border: 1px solid #5F5D5E; border-radius: 50%; line-height: 12px; text-align: center;
  }
</style>
