---
/**
 * A home, uma vez, nos três idiomas. A ordem é a do site atual: rotativo,
 * faixa institucional (D10) e as três caixas — notícias, vídeo, sustentabilidade.
 *
 * Rotativo com um banner só: a regra 0.2 do Marco 0 tira o que é anterior a
 * 2024 e sobra um por idioma. Carrossel volta a ser requisito (H1) com dois.
 *
 * Vídeo sob demanda (H4): a capa é local e o player do YouTube — ~1 MB, o
 * orçamento inteiro da página — só carrega no clique (public/js/site.js).
 * Sem JS, o link leva ao vídeo no YouTube.
 */
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { noticiasDe } from '../lib/acervo';
import { textos, prefixo, lang, CODIGO, type Idioma } from '../i18n/textos';
import { telas } from '../lib/banners';
import bannerPt from '../assets/banners/sustentabilidade-2025-pt.png';
import bannerEn from '../assets/banners/sustentabilidade-2025-en.png';
import bannerEs from '../assets/banners/energia-que-impulsa-la-vida.jpg';
import capaVideo from '../assets/video-institucional.jpg';

interface Props { idioma: Idioma }
const { idioma } = Astro.props;
const t = textos[idioma];
const pre = prefixo[idioma];
/* Uma lista por idioma, na mesma ordem dos textos em `textos.ts`. Acrescentar
   uma peça aqui e o texto dela lá liga o rotativo; com uma só, a home serve o
   banner estático de hoje, sem script e sem controles. */
const IMAGENS = { 'pt-br': [bannerPt], en: [bannerEn], es: [bannerEs] };
const rotativo = telas(IMAGENS[idioma], t.banner, idioma);
const gira = rotativo.length > 1;
const ICONES = ['meio-ambiente', 'agua', 'fauna-e-flora'].map((n) => `/img/tema/icone-${n}.png`);

// Os dois valores nulos são pendências da Alupar. A regra 4 do AGENTS.md: um
// número plausível é pior que um espaço vazio, porque ninguém o corrige depois.
const indicadores = [
  { valor: null,  rotulo: t.indicadores.linhas },
  { valor: '4',   rotulo: t.indicadores.paises },
  { valor: null,  rotulo: t.indicadores.capacidade },
  { valor: 'AAA', rotulo: t.indicadores.rating },
];

const formato = new Intl.DateTimeFormat(lang[idioma], { day: '2-digit', month: '2-digit', year: 'numeric', timeZone: 'UTC' });
const noticias = noticiasDe(CODIGO[idioma]).slice(0, 6);
---
<Base titulo={t.titulo} descricao={t.descricao} idioma={idioma} interna={false}>
  <main id="conteudo">
    <!-- O h1 do site atual é o logotipo com `font: 0/0 a`: nenhum texto chega
         ao leitor de tela. Aqui é texto real, oculto visualmente. -->
    <h1 class="sr-only">Alupar</h1>

    {/* Com uma tela isto rende exatamente o que rendia antes: um banner, nenhum
        controle, nenhum atributo de rotativo e nenhum script. O `data-rotativo`
        só aparece com duas ou mais, e é ele que liga o comportamento em
        public/js/site.js — sem ele, o script não registra nada. */}
    <section aria-label={t.destaques} class="destaques" data-rotativo={gira ? '' : undefined}
      aria-roledescription={gira ? 'carrossel' : undefined}>
      {rotativo.map((tela, i) => {
        const Destaque = tela.href ? 'a' : 'div';
        return (
          <Destaque href={tela.href ?? undefined} class="banner" data-tela={gira ? String(i) : undefined}
            hidden={gira && i > 0}
            aria-roledescription={gira ? 'tela' : undefined}
            aria-label={gira ? `${i + 1} de ${rotativo.length}` : undefined}>
            {/* `sizes` não é 100vw porque a caixa não tem a proporção da imagem: a
                arte é ~6:1 e a faixa é 2,86:1, então `object-fit: cover` amplia até
                a altura fechar e corta as laterais. Para os 447 px de altura o
                navegador precisa de ~2 690 px de largura — com 100vw ele escolhia a
                variante de 1 280 e a ampliava 2,1×, e era por isso que o banner saía
                mais mole que o do site atual, que serve o original de 2 560.
                210vw ≈ 6,01 ÷ 2,86 é a largura que a caixa de fato consome.
                Custo medido: a variante AVIF de 2 560 pesa 17 KB contra 8 KB da de
                1 350. O degrau de 1350w continua na lista pelo motivo de antes: o
                preset desktop do Lighthouse mede a caixa em 1 335 px. */}
            <Picture src={tela.imagem} alt={tela.alt} formats={['avif', 'webp']}
              widths={[640, 1350, 1920]} sizes="150vw"
              loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} />
            <span class="legenda"><strong>{tela.legenda}</strong></span>
          </Destaque>
        );
      })}

      {/* Controles só existem quando há o que controlar. Botões de verdade, para
          que teclado e leitor de tela os alcancem sem nada de especial. A pausa
          é exigência da WCAG 2.2.2 para conteúdo que se move sozinho. */}
      {gira && (
        <div class="controles">
          <button type="button" data-rot="anterior" aria-label={t.rotativo.anterior}>‹</button>
          {/* Os dois rótulos viajam na marcação: o script troca o `aria-label` ao
              alternar, e traduzir dentro do JS serviria só para o texto sair do
              i18n e envelhecer sozinho. */}
          <button type="button" data-rot="pausar" aria-pressed="false"
            aria-label={t.rotativo.pausar} data-pausar={t.rotativo.pausar} data-retomar={t.rotativo.retomar}>❚❚</button>
          <button type="button" data-rot="proxima" aria-label={t.rotativo.proxima}>›</button>
        </div>
      )}
    </section>

    <section class="faixa" aria-label={t.emNumeros}>
      <div class="container">
        <ul>
          {indicadores.map((i) => (
            <li>
              <span class="valor" data-pendente={i.valor === null}>{i.valor ?? '—'}</span>
              <span class="rotulo">{i.rotulo}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <div class="container caixas">
      <section class="caixa" aria-labelledby="h-noticias">
        <h2 id="h-noticias">{t.noticias}</h2>
        <ul class="noticias">
          {noticias.map((n) => (
            <li>
              <time datetime={n.data}>{formato.format(new Date(`${n.data}T00:00:00Z`))}</time>
              <a href={n.rota}>{n.titulo}</a>
            </li>
          ))}
        </ul>
        <a class="mais" href={`${pre}/noticias/`}><span class="circulo" aria-hidden="true">+</span> {t.verMaisNoticias}</a>
      </section>

      <section class="caixa" aria-labelledby="h-video">
        <h2 id="h-video">{t.videoInstitucional}</h2>
        <a class="video" href="https://www.youtube.com/watch?v=oqjwsKfpYZ4" data-video="oqjwsKfpYZ4" data-titulo={t.videoInstitucional}>
          <Picture src={capaVideo} alt="" formats={['avif', 'webp']} widths={[360, 720]} sizes="(min-width: 768px) 360px, 100vw" />
          <span class="sr-only">{t.assistirVideo}</span>
        </a>
        <a class="mais" href={`${pre}/videos/`}><span class="circulo" aria-hidden="true">+</span> {t.verMaisVideos}</a>
      </section>

      <section class="caixa" aria-labelledby="h-sustentabilidade">
        <h2 id="h-sustentabilidade">{t.sustentabilidade}</h2>
        <ul class="eixos">
          {t.eixos.map((e, n) => (
            <li>
              <img src={ICONES[n]} alt="" width="29" height="38" />
              <div>
                <h3><a href={t.sustentabilidadeHref}>{e.titulo}</a></h3>
                <p>{e.texto}</p>
              </div>
            </li>
          ))}
        </ul>
        <a class="mais" href={t.sustentabilidadeHref}><span class="circulo" aria-hidden="true">+</span> {t.saibaMais}</a>
      </section>
    </div>
  </main>
</Base>

<style>
  /* #home > .banner .item do tema (css/fullwidth/skin.css): faixa de 447 px em
     qualquer largura, com a imagem recortada para preencher (object-fit: cover).
     Sem a altura fixa, a proporção do arquivo manda: o banner PT media ~213 px
     em 1280 e ~65 px em 390 — uma tira, com a arte perdida no meio do cinza. */
  .banner { position: relative; display: block; height: 447px; }
  /* A seção reserva a mesma altura da tela: trocar de tela não pode empurrar a
     página, e o CLS que o CI cobra é 0,1. Com uma tela só isto não muda nada,
     porque a altura já era a do banner. */
  .destaques[data-rotativo] { position: relative; height: 447px; }
  .controles { position: absolute; right: 16px; bottom: 16px; display: flex; gap: 8px; }
  .controles button {
    width: 44px; height: 44px;                  /* área de toque da WCAG 2.5.8 */
    border: 1px solid rgba(255, 255, 255, .85); border-radius: 50%;
    background: rgba(0, 0, 0, .45); color: #fff; font-size: 15px; line-height: 1;
    cursor: pointer;
  }
  .controles button:hover { background: rgba(0, 0, 0, .65); }
  .banner :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  /* .content do tema (skin.css): caixa branca translúcida no alto à esquerda,
     texto azul em peso normal e um fio verde de 4 px na base, a 45% da largura.
     A partir de 1200 px a caixa começa no meio da tela e o texto vai a 38 px. */
  .legenda {
    position: absolute; top: 0; left: 0; padding: 20px 30px;
    background: rgba(255, 255, 255, .6);
    color: var(--azul); font-size: 18px; font-weight: 400;
  }
  /* O tema zera o negrito (`strong { font-weight: normal }` do style.css), e a
     legenda dele é justamente um <strong>: peso normal, tamanho da caixa. */
  .legenda strong { font-weight: inherit; font-size: inherit; }
  .legenda::after {
    content: ''; position: absolute; right: 0; bottom: 0;
    width: 45%; height: 4px; background: var(--verde);
  }
  @media (min-width: 1200px) {
    .legenda { left: 50%; max-width: 628px; font-size: 38px; }
  }

  .faixa { border-block: 1px solid var(--cinza-borda); background: var(--cinza-fundo); }
  .faixa ul {
    list-style: none; margin: 0; padding: var(--e5) 0;
    display: grid; gap: var(--e4);
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  }
  .faixa li { display: flex; flex-direction: column; gap: var(--e1); }
  .valor { font-size: 2rem; font-weight: 700; line-height: 1.1; color: var(--verde-texto); }
  .valor[data-pendente='true'] { color: var(--cinza); }
  .rotulo { font-size: .875rem; color: var(--preto); }

  /* .box-home do tema: branca, sombra 3px 3px 5px, título azul 20px */
  .caixas { display: grid; gap: 30px; padding-block: var(--e5) 50px; }
  @media (min-width: 768px) { .caixas { grid-template-columns: repeat(3, 1fr); } }
  .caixa {
    display: flex; flex-direction: column; background: var(--branco);
    padding: 1px 20px 8px; box-shadow: 3px 3px 5px 0 rgba(0, 0, 0, .2);
  }
  /* O título das caixas é verde e de peso normal no site atual: o tema pede
     azul em .box-home h3, mas um seletor solto mais abaixo no mesmo style.css
     (`.page-id-2810 h1, h3 { color: #079541 !important }`) alcança todos os h3
     da página, e `h1..h6 { font-weight: normal }` tira o negrito.
     O verde de texto é --verde-texto (4,51:1); o de marca dá 3,90:1. */
  .caixa h2 {
    color: var(--verde-texto); font-size: 20px; font-weight: 400;
    text-transform: uppercase; margin: 20px 0;
  }

  /* No tema a lista da caixa é um <ul> comum, sem folha que a redefina: vem o
     marcador de disco do navegador. A data está num <strong> com o negrito
     zerado pelo style.css, e o título é link azul sem sublinhado — sublinhado
     só no hover e no foco, como em todo link do tema. Numa lista de links
     (não de texto corrido), a ausência de sublinhado não fere a WCAG 1.4.1. */
  .noticias { list-style: disc; margin: 0; padding-left: 20px; flex: 1; }
  .noticias li { margin-bottom: 10px; }
  .noticias time { display: block; font-weight: 400; }
  .noticias a { color: var(--azul); text-decoration: none; }
  .noticias a:hover, .noticias a:focus-visible { text-decoration: underline; }

  /* o iframe é criado pelo site.js no clique e não recebe o atributo de
     escopo do Astro — por isso :global dentro de .caixa. */
  /* .embed-responsive-4by3 do tema: a caixa do vídeo é 4:3 e só isso — não
     estica. Com `flex: 1` ela crescia até o pé da caixa e virava um retrato de
     ~310 × 400 px em 1280, contra os ~320 × 240 px do site atual. É a margem
     automática do link "veja mais" que passa a empurrá-lo para a base. */
  .caixa .mais { margin-top: auto; }
  .caixa :global(.video) { position: relative; display: block; aspect-ratio: 4 / 3; }
  .caixa :global(.video) :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .caixa :global(.video)::after {
    content: '▶' / ''; position: absolute; inset: 0; display: grid; place-items: center;
    font-size: 3rem; color: var(--branco);
  }
  .caixa :global(iframe.video) { width: 100%; height: auto; border: 0; }

  .eixos { list-style: none; margin: 0; padding: 0; flex: 1; }
  .eixos li { display: flex; gap: 20px; padding-block: var(--e3); border-bottom: 1px solid #EFEEEF; }
  .eixos li:last-child { border-bottom: none; }
  /* .list-sustentabilidade .media do tema: o título de cada eixo é um
     h5.media-heading — 14 px, peso normal (o tema zera o negrito de h1 a h6),
     5 px embaixo — e o link é cinza-escuro sem sublinhado, com sublinhado no
     hover e no foco. Estava em negrito e sublinhado. */
  .eixos h3 { font-size: 14px; font-weight: 400; margin: 0 0 5px; }
  .eixos h3 a { color: var(--preto); text-decoration: none; }
  .eixos h3 a:hover, .eixos h3 a:focus-visible { text-decoration: underline; }
  .eixos p { margin: 0; line-height: 24px; }

  /* a.btn-link-mais do tema: caixa alta 12px, sublinhado verde de 4px */
  .mais {
    align-self: flex-end; margin: 9px -20px 0 0; padding: 0 5px 12px;
    position: relative; color: var(--preto); font-size: 12px; text-transform: uppercase; text-decoration: none;
  }
  .mais::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; border-bottom: 4px solid var(--verde); }
  .circulo {
    display: inline-block; width: 15px; height: 15px; margin-right: 3px;
    border: 1px solid #5F5D5E; border-radius: 50%; line-height: 12px; text-align: center;
  }
</style>
