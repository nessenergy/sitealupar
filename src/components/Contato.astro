---
/**
 * Contato: os dados publicados hoje, vindos do acervo sem o formulário antigo,
 * e o formulário novo — rótulo visível em cada campo (C1), a única mudança
 * realmente perceptível do projeto, já prevista em restauro-fiel.
 *
 * Sem `PUBLIC_TURNSTILE_SITE_KEY` no build (máquina local), usa a chave de
 * teste da Cloudflare, que sempre aprova. Em produção a chave vem do CI.
 */
import Base from '../layouts/Base.astro';
import Trilha from './Trilha.astro';
import { itens, semFormulario } from '../lib/acervo';
import { degraus } from '../lib/trilha.ts';
import { textos, prefixo, type Idioma } from '../i18n/textos';
import { ACAO_CONTATO } from '../lib/contato';

interface Props { idioma: Idioma; aviso?: 'obrigado' | 'nao-enviado' }
const { idioma, aviso } = Astro.props;
const t = textos[idioma];
const f = t.formulario;
const pre = prefixo[idioma];
const item = itens().find((i) => i.rota === `${pre}/contato/`);
if (!item) throw new Error(`acervo sem ${pre}/contato/`);
// `||`, não `??`: variável de repositório ausente chega ao build como string vazia.
const CHAVE = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '1x00000000000000000000AA';
---
<Base titulo={`${item.titulo} — Alupar`} descricao={t.descricao} idioma={idioma} noindex={Boolean(aviso)}
  degraus={degraus(Astro.url.pathname, idioma, item.titulo)}>
  <main id="conteudo" class="container pagina">
    <div class="caixa">
    <Trilha idioma={idioma} titulo={item.titulo} />
    <h1>{item.titulo}</h1>
    {aviso && <p class="aviso" role="status">{aviso === 'obrigado' ? f.obrigado : f.naoEnviado}</p>}
    <div class="dados" set:html={semFormulario(item.corpo)} />

    {aviso !== 'obrigado' && (
      <form method="post" action="/api/contato" aria-describedby="obrigatorios"
        data-mensagens={JSON.stringify(f.erros)} data-resumo={f.resumo}
        data-enviando={f.enviando} data-falha={f.falhaEnvio}>
        <input type="hidden" name="prefixo" value={`${pre}/`} />
        <p id="obrigatorios">{f.obrigatorios}</p>
        <div id="estado" class="aviso" role="alert" tabindex="-1" hidden></div>
        <div class="campo"><label for="nome">{f.nome} *</label><input id="nome" name="nome" required autocomplete="name" /><p class="erro" id="erro-nome" hidden></p></div>
        <div class="campo"><label for="email">{f.email} *</label><input id="email" name="email" type="email" required autocomplete="email" /><p class="erro" id="erro-email" hidden></p></div>
        <div class="campo"><label for="empresa">{f.empresa}</label><input id="empresa" name="empresa" autocomplete="organization" /></div>
        <div class="campo"><label for="telefone">{f.telefone}</label><input id="telefone" name="telefone" type="tel" autocomplete="tel" /></div>
        <div class="campo largo"><label for="assunto">{f.assunto} *</label><input id="assunto" name="assunto" required /><p class="erro" id="erro-assunto" hidden></p></div>
        <div class="campo largo"><label for="mensagem">{f.mensagem}</label><textarea id="mensagem" name="mensagem" rows="8" maxlength="5000"></textarea><p class="erro" id="erro-mensagem" hidden></p></div>
        <div class="consentimento">
          <input id="consentimento" name="consentimento" type="checkbox" value="sim" required />
          <label for="consentimento">{f.consentimento} <a href={t.rodape.privacidadeHref}>{t.rodape.privacidade}</a>. *</label>
        </div>
        <p class="erro" id="erro-consentimento" hidden></p>
        {/* O api.js da Cloudflare NÃO é carregado aqui: public/js/site.js o injeta
            na primeira interação com o formulário. Depois de rodar, o script puxa
            por dentro de si ~580 KB que o Lighthouse soma ao peso da página sem
            listar entre os recursos — /contato/ mediu 629.754, 656.918 e 674.678 B
            em três execuções da mesma revisão, contra o teto de 614.400 B do CI,
            e desse total só ~95 KB são nossos. O contrato antispam não muda: quem
            recusa envio sem token válido, com ação e hostname conferidos, é
            functions/api/contato.ts. O widget continua nascendo NESTE container,
            com a mesma chave e a mesma `data-action` — o api.js o encontra pela
            classe .cf-turnstile ao carregar (render implícito). */}
        <div class="cf-turnstile" data-sitekey={CHAVE} data-language={idioma} data-action={ACAO_CONTATO}></div>
        <p class="erro" id="erro-verificacao" hidden></p>
        {/* Sem JavaScript não há widget nem token, e a Function recusa o envio —
            comportamento que já era este. O aviso troca o silêncio por um caminho. */}
        <noscript><p class="aviso">{f.semJavascript}</p></noscript>
        <button type="submit">{f.enviar}</button>
      </form>
    )}
    </div>
  </main>
</Base>

<style>
  /* A caixa branca e o título verde vêm de tokens.css. O resto é o tema:
     endereço e assessoria de imprensa em duas colunas a partir de 768 px (o
     corpo do acervo traz .row com dois .col-sm-6), rótulo da assessoria em
     verde (`.txt-show address p span`), campos com a pele do .form-control —
     fundo cinza em degradê, fio #DCDCDC, canto vivo — "Assunto" na largura
     toda e botão centralizado, como o .col-sm-12.text-center do tema.

     Duas coisas do tema não voltam, e as duas têm motivo: os rótulos visíveis
     de cada campo (critério C1 do PRD — o tema só tem placeholder, que não é
     rótulo) e o `text-transform: uppercase` do .form-control, que poria em
     caixa alta o que a pessoa digita. Isso é o dado, não o desenho. */
  .dados :global(.row) { display: grid; gap: var(--e4); }
  @media (min-width: 768px) { .dados :global(.row) { grid-template-columns: 1fr 1fr; } }
  .dados :global(.col-sm-6 > p > span) { color: var(--verde-texto); }

  .aviso { padding: var(--e3); border-left: 4px solid var(--verde); background: var(--cinza-fundo); }
  form { display: grid; gap: var(--e3); margin-top: var(--e5); }
  @media (min-width: 768px) { form { grid-template-columns: 1fr 1fr; } .largo, .consentimento, #obrigatorios, #estado, #erro-consentimento, #erro-verificacao, .cf-turnstile, noscript, button { grid-column: 1 / -1; } }
  .erro { margin: 0; font-size: .875rem; color: var(--erro); }
  /* Mais específico que `input:not([type='checkbox'])` mais abaixo, que senão vence por vir depois.
     O anel de 1 px dá a borda de 2 px sem mexer no layout. */
  input:not([type='checkbox'])[aria-invalid='true'], textarea[aria-invalid='true'] { border-color: var(--erro); box-shadow: 0 0 0 1px var(--erro); }
  #estado { border-left-color: var(--erro); }
  #estado:focus { outline-offset: 2px; }
  /* A altura do widget fica reservada antes de ele existir: carregado só na
     interação, o Turnstile nasceria num container de altura 0 e empurraria o
     botão para baixo. 65 px é a altura do widget padrão — se a Cloudflare
     mudar esse desenho, o resto do deslocamento volta. O deslocamento seria
     depois da interação da pessoa, que o CLS não conta, mas quem está olhando
     a tela conta. */
  .cf-turnstile { min-height: 65px; }
  .campo { display: flex; flex-direction: column; gap: var(--e1); }
  label { font-weight: 600; }
  input:not([type='checkbox']), textarea {
    font: inherit; padding: 6px 12px; color: #231F20;
    border: 1px solid #DCDCDC; border-radius: 0;
    background: linear-gradient(to bottom, #FFFFFF 0, #E0E0E0 100%) #EEEEEE;
  }
  .consentimento { display: flex; gap: var(--e2); align-items: flex-start; }
  button {
    justify-self: center; font: inherit; text-transform: uppercase; cursor: pointer;
    padding: 10px 20px; border: 0; background: var(--azul-hover); color: var(--branco);
  }
  button:hover, button:focus-visible { background: var(--azul); }
</style>

<script>
  import { errosDoFormulario, type Mensagens, type Erro } from '../lib/contato-cliente';

  const form = document.querySelector<HTMLFormElement>('form[data-mensagens]');
  if (form) {
    const msgs = JSON.parse(form.dataset.mensagens!) as Mensagens;
    const estado = form.querySelector<HTMLElement>('#estado')!;
    const botao = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const rotuloBotao = botao.textContent;
    // As mensagens passam a ser nossas: a caixa nativa do navegador não fala com a página.
    form.noValidate = true;

    const limpar = () => {
      form.querySelectorAll<HTMLElement>('.erro').forEach((p) => { p.textContent = ''; p.hidden = true; });
      form.querySelectorAll('[aria-invalid]').forEach((i) => { i.removeAttribute('aria-invalid'); i.removeAttribute('aria-describedby'); });
      estado.textContent = ''; estado.hidden = true;
    };
    const dizer = (texto: string) => { estado.textContent = texto; estado.hidden = false; estado.focus(); };

    const mostrar = (erros: Erro[]) => {
      for (const { campo, mensagem } of erros) {
        const p = form.querySelector<HTMLElement>(`#erro-${campo}`)!;
        p.textContent = mensagem; p.hidden = false;
        const entrada = form.querySelector<HTMLElement>(`#${campo}`);
        entrada?.setAttribute('aria-invalid', 'true');
        entrada?.setAttribute('aria-describedby', p.id);
      }
      // Foco no primeiro campo com erro; se o único erro é a verificação, no resumo.
      const primeiro = erros.map((e) => form.querySelector<HTMLElement>(`#${e.campo}`)).find(Boolean);
      estado.textContent = form.dataset.resumo!; estado.hidden = false;
      (primeiro ?? estado).focus();
    };

    const falhou = () => {
      botao.disabled = false; botao.textContent = rotuloBotao;
      (window as unknown as { turnstile?: { reset(): void } }).turnstile?.reset();
      dizer(form.dataset.falha!);
    };

    form.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      limpar();
      const dados = new FormData(form);
      const d = Object.fromEntries([...dados].map(([k, v]) => [k, String(v)]));
      const erros = errosDoFormulario(d, msgs);
      if (erros.length) return mostrar(erros);

      botao.disabled = true; botao.textContent = form.dataset.enviando!;
      try {
        // A Function responde 303 para uma página estática; o fetch segue e a URL final diz o resultado.
        const r = await fetch(form.action, { method: 'POST', body: dados });
        if (r.url.endsWith('/contato/obrigado/')) return void location.assign(r.url);
      } catch { /* cai em falhou() */ }
      falhou();
    });
  }
</script>
