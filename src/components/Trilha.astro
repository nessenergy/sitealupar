---
/**
 * Trilha de navegação das páginas internas — o breadcrumb do site atual.
 *
 * No tema ela mora DENTRO da caixa branca, como primeiro elemento, acima do
 * título, e não aparece abaixo de 768 px (`hidden-xs`). Por isso é componente
 * usado por cada página, e não algo que o Base.astro imprima sozinho.
 *
 * Quem monta os degraus é `src/lib/trilha.ts` — lá a regra tem teste.
 *
 * "Você está em:" é rótulo, não degrau: no site atual ele é o TEXTO DO LINK
 * para a home (`<a class="bread-home" href="…" title="Você está em:">Você
 * está em:</a>`), e o nome da home se perde. Aqui o rótulo fica em texto
 * solto e o primeiro degrau ganha o nome que o próprio site publica no
 * JSON-LD da mesma página: "Início".
 */
import { degraus } from '../lib/trilha.ts';
import { textos, type Idioma } from '../i18n/textos';

interface Props {
  idioma: Idioma;
  /** Título da página atual, o último degrau da trilha. */
  titulo: string;
}
const { idioma, titulo } = Astro.props;
const t = textos[idioma];
const passos = degraus(Astro.url.pathname, idioma, titulo);
---
<nav class="trilha" aria-label={t.trilhaNav}>
  <span class="rotulo">{t.trilha}</span>
  <ol>
    {passos.map((p) => (
      <li>{p.rota ? <a href={p.rota}>{p.titulo}</a> : <strong aria-current="page">{p.titulo}</strong>}</li>
    ))}
  </ol>
</nav>

<style>
  /* `.breadcrumb` do tema: 12 px, azul #115EA9 (6,9:1 sobre branco), sem fundo,
     8 px acima e abaixo, 20 px sob a trilha, e o separador ">" com 5 px de cada
     lado. O `hidden-xs` do tema some com ela abaixo de 768 px. */
  .trilha { display: none; }
  @media (min-width: 768px) {
    .trilha {
      display: block;
      margin: 0 0 20px;
      padding: 8px 0;
      font-size: 12px;
      color: #115EA9;
    }
  }

  /* O rótulo e a lista numa linha só, como no tema — que abre a `<ul>` com um
     `&nbsp;`. O recuo e a margem são da `<nav>`, não da `<ol>`. */
  ol { display: inline; margin: 0; padding: 0; list-style: none; }
  li { display: inline-block; }
  li + li::before { content: '>\00a0'; padding: 0 5px; color: #115EA9; }
  a { color: #115EA9; }
  /* O tema põe o degrau atual num <strong>, e zera o negrito no style.css. */
  strong { font-weight: 400; }
</style>
