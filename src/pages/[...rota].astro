---
/**
 * As 378 páginas de conteúdo, em uma rota.
 *
 * O que decide quais rotas existem é `acervo/mapa-de-rotas.json`, não este
 * arquivo — e é de propósito: a decisão de o que vira página foi tomada,
 * conferida contra o mapa de 301 e travada no CI (#47). Aqui só se lê.
 */
import Base from '../layouts/Base.astro';
import Trilha from '../components/Trilha.astro';
import { itens, IDIOMA_ASTRO, SUBSTITUIDAS } from '../lib/acervo';
import { textos } from '../i18n/textos';
import { ehCasca } from '../lib/casca.mjs';
import { degraus } from '../lib/trilha.ts';

export function getStaticPaths() {
  return itens().filter((i) => !SUBSTITUIDAS.has(i.rota)).map((i) => ({
    /* O mapa guarda a rota com barra na frente e atrás; o parâmetro não leva
       nenhuma das duas. `build.format: 'directory'` devolve a barra final. */
    params: { rota: i.rota.replace(/^\/|\/$/g, '') },
    props: { item: i },
  }));
}

const { item } = Astro.props;
const idioma = IDIOMA_ASTRO[item.idioma];
const t = textos[idioma];
/* Os mesmos degraus que a Trilha desenha, para o BreadcrumbList do layout — de
   uma fonte só, senão a tela e o schema divergem no primeiro título que mudar. */
const passos = degraus(Astro.url.pathname, idioma, item.titulo);

/* Data só aparece onde significa alguma coisa. Numa página institucional a
   data de publicação do WordPress é ruído: diz quando alguém salvou o registro,
   não quando o fato aconteceu. */
const dataVisivel = item.tipo === 'noticia' && item.data ? new Date(`${item.data}T00:00:00Z`) : null;

/* `timeZone: 'UTC'` não é detalhe: a data vem sem hora, o construtor assume
   meia-noite UTC, e formatar em qualquer fuso a oeste devolveria o dia
   anterior. O site inteiro erraria um dia dependendo de onde o build roda. */
const dataLegivel = dataVisivel
  ? new Intl.DateTimeFormat(idioma, { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(dataVisivel)
  : null;
---
<Base titulo={`${item.titulo} — Alupar`} descricao={t.descricao} idioma={idioma} noindex={ehCasca(item)} degraus={passos}>
  <main id="conteudo" class="container pagina">
    <article>
      <Trilha idioma={idioma} titulo={item.titulo} />
      <header class="cabecalho">
        <h1>{item.titulo}</h1>
        {dataVisivel && <time datetime={item.data}>{dataLegivel}</time>}
      </header>

      {/* O corpo vem balanceado por parser (#46) e com as correções de
          acessibilidade que são do template já aplicadas (src/lib/acervo.ts).
          Sem o balanceamento, esta linha produziria HTML inválido em 211
          páginas — foi o que travou a geração até agora. */}
      <div class="corpo" set:html={item.corpo} />
    </article>
  </main>
</Base>

<style>
  /* .box-interna.box-home do tema: o conteúdo das internas mora numa caixa
     branca com sombra, colada à base da faixa de foto e sobre o fundo cinza da
     página — daí a margem zero no topo. O recheio é o do tema (10px 35px 40px);
     no celular a caixa sangra até a borda da tela e o recheio cai para 20 px.
     A largura da coluna é a da caixa: com `max-width: 72ch` o texto ficava numa
     tira de ~620 px no meio de uma caixa de 1070 px. */
  .pagina { padding-block: 0 var(--e7); }

  article {
    background: var(--branco);
    padding: 10px 35px 40px;
    box-shadow: 3px 3px 5px 0 rgba(0, 0, 0, .2);
  }

  @media (max-width: 767px) {
    .pagina { padding-inline: 0; }
    article { padding: 10px 20px 40px; }
  }

  /* `.txt-show h1` do tema: verde, peso normal, 26 px — 48 px a partir de
     992 px, com 30 px embaixo e sem fio nenhum. Estava azul, em negrito, com
     um fio cinza que o tema não tem. O verde é --verde-texto (4,51:1); o de
     marca dá 3,90:1 e reprova AA. */
  .cabecalho { margin-bottom: var(--e4); }
  .cabecalho h1 {
    margin: 0 0 30px;
    font-size: 26px;
    font-weight: 400;
    line-height: 1.2;
    color: var(--verde-texto);
    text-wrap: balance;
  }
  @media (min-width: 992px) { .cabecalho h1 { font-size: 48px; } }
  .cabecalho time {
    display: block;
    margin-top: var(--e2);
    font-size: .875rem;
    color: var(--cinza);
  }

  /* O corpo é HTML herdado do site atual: a folha precisa dar conta do que
     vier, e não do que gostaríamos que viesse. As classes do tema chegam
     inteiras no corpo do acervo (txt-show, list-show, text-justify, btn-azul,
     panel-body), então o valor de cada regra é o do style.css do tema. */
  .corpo { line-height: 26px; }
  /* Nome de arquivo vira título e texto de link ("Politica_de_Seguranca_do_
     Trabalho_e_Saude_Ocupacional-12-08-2020"): sem espaço, é uma palavra de 60
     caracteres que não cabe em 390 px e empurra a página até +354 px. `break-word`
     não bastou: o `article` é dimensionado pelo tamanho mínimo do conteúdo, que
     ele não reduz; `anywhere` reduz. Fica só no título e nos links, onde o
     problema está, para não mexer no tamanho mínimo de tabelas e colunas. */
  .cabecalho h1, .corpo :global(a) { overflow-wrap: anywhere; }

  /* .txt-show h2/h3/h4: grandes e em peso normal. O h3 é verde pelo mesmo
     seletor solto que pinta o título das caixas da home. */
  .corpo :global(h2) {
    margin: var(--e6) 0 var(--e3);
    font-size: 32px;
    font-weight: 400;
    line-height: 1.3;
    color: var(--azul);
  }
  .corpo :global(h3) {
    margin: var(--e5) 0 var(--e2);
    font-size: 26px;
    font-weight: 400;
    color: var(--verde-texto);
  }
  .corpo :global(h4) { margin: var(--e5) 0 var(--e2); font-size: 20px; font-weight: 400; color: var(--cinza); }
  /* O h1 da página é de 26 px até 992 px (48 px depois). Com o h2 fixo em 32 px
     e o h3 em 26 px, o subtítulo ficava maior que o título no celular e no
     tablet — "Transmissão de energia: a espinha dorsal do negócio" em três
     linhas, acima de "Área de atuação". Abaixo de 992 px a escada desce junto:
     26 → 24 → 22 → 20. */
  @media (max-width: 991px) {
    .corpo :global(h2) { font-size: 24px; }
    .corpo :global(h3) { font-size: 22px; }
  }
  .corpo :global(p) { margin: 0 0 var(--e3); }
  .corpo :global(ul), .corpo :global(ol) { margin: 0 0 var(--e3); padding-left: var(--e4); }
  .corpo :global(li) { margin-bottom: var(--e1); }
  .corpo :global(img) { max-width: 100%; height: auto; }
  /* O WordPress grava a largura do arquivo no `<video width="1280">`, e só a
     imagem tinha teto: 12 tipos de página-casca de vídeo (53 medições) saíam
     da tela — +930 px a 390 px e +105 px a 1280 px. `height: auto` mantém a
     proporção do vídeo (o navegador a tira de width/height). O iframe só ganha
     o teto de largura: a altura dele é do embed. */
  .corpo :global(video) { max-width: 100%; height: auto; }
  .corpo :global(iframe), .corpo :global(embed), .corpo :global(object) { max-width: 100%; }

  /* O banner de âncoras de Empresas (`.img-empresas`) perdeu a imagem na
     migração e sobrou o vão: `<p>&nbsp;</p>` e um `.hotspots` de espaços,
     ~100 px de nada logo abaixo do título — e, em EN, um link `hotspots-esq`
     focável sem nada visível. Nenhum dos dois faz nada por quem enxerga. */
  .corpo :global(.img-empresas) { display: none; }

  /* O tema zera o negrito do conteúdo (`strong { font-weight: normal }`): os
     rótulos da FAQ, os nomes das empresas e a abertura da ata saem em peso
     normal, como no site atual. */
  .corpo :global(strong) { font-weight: 400; }

  /* Link de texto em azul, como no tema. O sublinhado NÃO sai: sem ele, azul e
     preto do texto ficam a 1,59:1 um do outro, abaixo dos 3:1 que a WCAG 1.4.1
     exige para distinguir link por cor — fica em Mudanças deliberadas. */
  .corpo :global(a) { color: var(--azul); }

  /* Alinhamentos que o conteúdo declara e ninguém estilizava. */
  .corpo :global(.text-justify) { text-align: justify; }
  /* Justificado em coluna de 350 px, o espaço entre palavras médio vai de 3,4
     para 8,4 px na Política de Privacidade (9,2 px em Empresas, 93 parágrafos),
     com picos de 48 px: rios brancos no meio do texto. No desktop a média é de
     5,5 px e o desenho do tema se mantém. */
  @media (max-width: 767px) {
    .corpo :global(.text-justify) { text-align: left; }
  }
  .corpo :global(.text-center), .corpo :global(.aligncenter) { text-align: center; }
  .corpo :global(.alignright) { text-align: right; }

  /* A limpeza do conteúdo tirou os `style` embutidos, e com eles o centro dos
     mapas. A classe do WordPress sobreviveu: é ela que volta a centralizar —
     numa imagem, `text-align` no próprio elemento não centraliza nada. */
  .corpo :global(img.aligncenter) { display: block; margin-inline: auto; }

  /* Mapa de ativos (Área de atuação e A Companhia). A legenda saiu da imagem:
     desenhada nela, o texto caía a ~6 px no celular e só existia em português.
     Agora é lista de verdade, nos três idiomas, e o mapa não muda.

     Com o mapa em 580 px ou mais, a legenda volta ao canto vazio da imagem
     (Patagônia à esquerda, o resto do quadrante em branco), que é onde ela
     estava desenhada. Abaixo disso não há espaço ao lado sem pisar na
     Argentina, então desce para baixo do mapa, em grade. Container query, não
     media query: quem manda é a largura do mapa, não a da tela. */
  .corpo :global(.mapa) { position: relative; max-width: 600px; margin: var(--e4) auto; container-type: inline-size; }
  .corpo :global(.mapa > img) { display: block; width: 100%; height: auto; }
  .corpo :global(.list-show .legenda) {
    list-style: none; margin: var(--e3) 0 0; padding: 0;
    display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: var(--e2) var(--e4);
  }
  .corpo :global(.list-show .legenda li) {
    display: flex; align-items: center; gap: 10px; margin: 0; padding: 0;
    font-size: 13px; font-weight: 700; line-height: 1.3; color: var(--azul);
  }
  .corpo :global(.list-show .legenda li::before) { content: none; }
  .corpo :global(.legenda img) { flex: none; width: 28px; height: 28px; }
  /* Linha e ponto da legenda: os dois símbolos que não são ícone colorido. */
  .corpo :global(.legenda .ic) { flex: none; display: grid; place-items: center; width: 28px; height: 28px; }
  .corpo :global(.legenda .lt::before) { content: ''; width: 28px; height: 2px; background: var(--azul); }
  .corpo :global(.legenda .se::before) { content: ''; width: 8px; height: 8px; border-radius: 50%; background: var(--azul); }
  @container (min-width: 580px) {
    .corpo :global(.list-show .legenda) {
      position: absolute; left: 52%; top: 62%; margin: 0;
      display: flex; flex-direction: column; gap: 8px;
    }
  }

  /* .list-show do tema: marcador verde desenhado, no lugar do disco do
     navegador, com 17 px de recuo. */
  .corpo :global(.list-show ul) { list-style: none; padding-left: 0; }
  .corpo :global(.list-show ul li) { position: relative; padding-left: 17px; }
  .corpo :global(.list-show ul li::before) {
    content: '\2022';
    position: absolute; left: 0; top: -2px;
    font-size: 1.5em; color: var(--verde);
  }

  /* .panel-body do bootstrap, que o tema herda: é o recuo dos parágrafos do
     Programa de P&D. */
  .corpo :global(.panel-body) { padding: 15px; }

  /* a.btn-azul do tema: botão azul de caixa alta, não link de texto. */
  .corpo :global(.btn-azul) {
    display: inline-block; padding: 10px 20px;
    background: var(--azul-hover); color: var(--branco);
    text-transform: uppercase; text-decoration: none;
    /* O tema zera o raio de propósito (`border-radius: 0px`), porque o .btn do
       bootstrap põe 4 px — e o acervo traz `class="btn btn-azul"`. Aqui o
       bootstrap não é carregado, mas a regra fica explícita: o canto vivo é
       decisão do tema, não ausência de folha. */
    border-radius: 0;
  }
  .corpo :global(.btn-azul:hover), .corpo :global(.btn-azul:focus) {
    background: var(--azul); color: var(--branco);
  }

  /* Sanfona do tema (.arconix-faq-*): seções fechadas, título verde de 18 px
     com recheio 20px 40px 20px 20px, fio cinza embaixo e fundo que clareia no
     hover. Quem fecha e abre é o próprio navegador: o embrulho é um
     `<details>` e o título um `<summary>`, trocados no build por
     src/lib/acervo.ts. O `<div>` do tema não recebe foco nem responde ao
     teclado; o `<summary>` recebe e responde, sem uma linha de script — e
     nasce fechado no HTML, sem deslocar a página depois de pintada.

     `display: block` e `list-style: none` tiram o triângulo que o navegador
     põe no `<summary>`: a seta daqui é a de baixo.

     A seta é um chevron de texto. O tema pede os glifos f106/f107 do Font
     Awesome com `font-family: "Open Sans"`, que não os tem: o que aparece no
     site atual é o quadrado de caractere ausente, e restaurar um defeito de
     fonte não é restaurar o desenho. */
  /* O fio de 1 px é só do título (style.css:1667 e 1668-1670): o conteúdo
     também declara `border-bottom: 1px #c7c7c7 solid` (style.css:1703), mas a
     linha seguinte (`border: 1px solid transparent`, style.css:1705) o apaga
     inteiro — o que se vê no site atual é uma linha por seção, embaixo do
     título. A sombra rasa vai nos dois, como no tema. */
  .corpo :global(.arconix-faq-title) {
    border-bottom: 1px solid #C7C7C7;
    box-shadow: 0 1px 1px rgba(0, 0, 0, .05);
  }
  .corpo :global(summary.arconix-faq-title) {
    position: relative; display: block; list-style: none;
    padding: 20px 40px 20px 20px;
    cursor: pointer;
    font-size: 18px; color: var(--verde-texto);
  }
  .corpo :global(summary.arconix-faq-title::-webkit-details-marker) { display: none; }
  .corpo :global(summary.arconix-faq-title:hover) { background: #F6F6F6; color: var(--azul); }
  .corpo :global(summary.arconix-faq-title::after) {
    content: '\2304'; position: absolute; right: 8px; top: 18px;
    font-size: 24px; line-height: 1;
  }
  .corpo :global(details[open] > summary.arconix-faq-title::after) { content: '\2303'; }
  .corpo :global(.arconix-faq-content) {
    padding: 15px 20px;
    border: 1px solid transparent;
    border-radius: 4px;
    box-shadow: 0 1px 1px rgba(0, 0, 0, .05);
  }

  .corpo :global(.rolagem) {
    overflow-x: auto;
    margin-bottom: var(--e4);
    border: 1px solid var(--cinza-borda);
  }
  .corpo :global(table) {
    border-collapse: collapse;
    width: 100%;
    font-size: .9375rem;
  }
  .corpo :global(th), .corpo :global(td) {
    padding: var(--e2) var(--e3);
    border-bottom: 1px solid var(--cinza-borda);
    text-align: left;
    vertical-align: top;
  }
  .corpo :global(th) { background: var(--cinza-fundo); font-weight: 600; }
  .corpo :global(td) { font-variant-numeric: tabular-nums; }
</style>
