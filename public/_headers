# Cabeçalhos de borda — Cloudflare Pages.
# O institucional hoje não envia CSP, Referrer-Policy nem Permissions-Policy;
# o portal de RI já envia. Isto equipara os dois.

/*
  Content-Security-Policy: default-src 'self'; img-src 'self' data: https://files.workr.com.br; style-src 'self' 'unsafe-inline'; script-src 'self' https://challenges.cloudflare.com https://static.cloudflareinsights.com; connect-src 'self' https://cloudflareinsights.com; frame-src https://www.youtube-nocookie.com https://challenges.cloudflare.com; media-src https://arquivos.alupar.com.br; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  # HSTS SEM includeSubDomains e SEM preload, deliberadamente: o domínio é
  # compartilhado com ri.alupar.com.br, que é de outra equipe. Estender a
  # política aos subdomínios é decisão conjunta, não nossa. Rever com eles.
  Strict-Transport-Security: max-age=31536000

# Assets versionados pelo build podem ser imutáveis.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# A fonte é a única coisa com `preload` nas 400 páginas (26 680 B): sem regra
# aqui ela cai no padrão do Pages e volta ao servidor mais do que precisa.
# NÃO pode ser `immutable`: o nome do arquivo não carrega hash de conteúdo, e
# `immutable` promete que o conteúdo daquela URL nunca muda — trocar a fonte
# deixaria caches servindo a antiga até o fim do max-age, sem revalidar. Uma
# semana cobre a visita recorrente e limita o estrago de uma troca. Vira
# `immutable` com um ano no dia em que o arquivo passar a ter hash no nome
# (servido de /_astro/, por exemplo).
/fonts/*
  Cache-Control: public, max-age=604800

# sitealupar.pages.dev é endereço técnico: não pode concorrer com o domínio.
https://:project.pages.dev/*
  X-Robots-Tag: noindex
